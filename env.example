# =================================================================
# Telegram Music Addon - Environment Configuration
# Copy this file to ".env" and fill in your values.
# Parameters left blank are unused. No value is required unless
# the feature it controls is something you want to enable.
# =================================================================

# ── Required: Telegram Credentials ───────────────────────────────
# Get API ID and API Hash from https://my.telegram.org

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your session string. Generated by "npm run login" or the Web Setup Wizard.
TELEGRAM_SESSION_STRING=

# Your private music channel. Use the numeric ID (e.g. -1001234567890) or @username.
TELEGRAM_CHANNEL=

# ── Optional: Server Settings ─────────────────────────────────────
# HTTP port the server listens on. Default: 3000
PORT=3000

# Secret path prefix for public deployments.
# When set, BitChord must connect via: https://<domain>/<secret>/manifest.json
# Calls without the secret receive HTTP 401. Leave blank for no protection.
URL_SECRET=

# Legacy alias for URL_SECRET. Use URL_SECRET instead.
# ACCESS_TOKEN=

# Custom public domain or reverse proxy host.
# Example: https://your-pc.tailnet.ts.net
# Takes priority over the Cloudflare tunnel URL when set. Leave blank to auto-detect.
PUBLIC_URL=

# Auto-start a Cloudflare Quick Tunnel on server boot. Default: true
# Set to false if you use Tailscale Funnel, Ngrok, or your own domain.
ENABLE_CLOUDFLARE_TUNNEL=true

# ── Optional: Bot Automation ──────────────────────────────────────
# Bot token from @BotFather.
# Required for: in-channel /s and /song search with interactive buttons,
# duplicate cleanup notices posted via bot instead of your personal account.
# Without this, /s and /song commands do not work.
TELEGRAM_BOT_TOKEN=

# Keep bot state synced with Telegram. Default: false
ENABLE_BOT_SYNC=false

# ── Optional: Channel Notifications ──────────────────────────────
# Post deduplication digest summaries to the channel. Default: false (silent)
ENABLE_CHANNEL_NOTIFICATIONS=false

# Secondary channel to auto-sync tracks uploaded via TeleDrive. Leave blank to disable.
TELEDRIVE_CHANNEL=

# ── Internal / Debug ──────────────────────────────────────────────
# Set to true to open the browser on server start (used by setup.bat and Install-Telegram-Music.bat).
# OPEN_BROWSER=true
