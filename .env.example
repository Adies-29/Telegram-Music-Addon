# =================================================================
# Telegram Music Addon - Environment Configuration Template
# Copy this file to ".env" and fill in your values.
# All unconfigured or blank optional parameters will use safe defaults.
# =================================================================

# ── Core Telegram Credentials (Required) ─────────────────────────
# Get your API ID and Hash from https://my.telegram.org (takes 1 minute)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated automatically by "npm run login" or the Web Setup Wizard:
TELEGRAM_SESSION_STRING=

# Your music channel: private numeric ID (e.g. -1001234567890) or public @username
TELEGRAM_CHANNEL=

# ── Server & Networking Settings (Optional) ──────────────────────
# Local server port (Default: 3000)
PORT=3000

# Optional URL Secret path protection (e.g. URL_SECRET=mysecret)
# When set, BitChord must use: https://<domain>/mysecret/manifest.json
URL_SECRET=

# Custom Public Domain or Reverse Proxy (e.g. https://your-pc.tailnet.ts.net)
# Takes priority over Cloudflare Tunnel when specified.
PUBLIC_URL=

# Automatic Cloudflare Quick Tunnel (Default: true)
# Set to false if you use Tailscale Funnel, Ngrok, or your own domain.
ENABLE_CLOUDFLARE_TUNNEL=true

# ── Telegram Bot Automation (Optional) ───────────────────────────
# Dedicated bot token from @BotFather for in-channel /song search and inline buttons [1]..[7]
# Required if you want channel search commands and duplicate cleanup notices posted via bot.
TELEGRAM_BOT_TOKEN=
ENABLE_BOT_SYNC=false

# ── Channel Notifications & Sync (Optional) ──────────────────────
# Post periodic deduplication summary digests to the channel (Default: false / silent)
ENABLE_CHANNEL_NOTIFICATIONS=false

# Optional secondary channel ID to auto-sync tracks uploaded via TeleDrive
TELEDRIVE_CHANNEL=
